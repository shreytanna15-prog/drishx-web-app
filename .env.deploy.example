# Copy to `.env.deploy` (never commit `.env.deploy`).
# Use the same Person X values across all repos; only branch names may differ per repo.

# GitHub PAT for Person X (repo scope) — used for one-shot push to deploy branch
DEPLOY_GH_TOKEN=

# Git author for the trigger commit only (Person X identity)
DEPLOY_GIT_NAME=
DEPLOY_GIT_EMAIL=

# Branch that Vercel production deploys from (default: main)
DEPLOY_BRANCH=main

# Branch to merge deploy branch into after trigger (default: dev)
# This repo only has `main` today — set DEPLOY_SKIP_SYNC=1 until you add a dev branch.
DEPLOY_SYNC_BRANCH=dev

# Set to 1 to skip merge/push to sync branch (use when no dev branch exists yet)
DEPLOY_SKIP_SYNC=1

# Git remote name (default: origin)
DEPLOY_REMOTE=origin
